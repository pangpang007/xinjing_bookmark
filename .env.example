# 服务器
PORT=8080

# 数据库（Supabase）
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Redis（docker-compose 内部服务会覆盖为 redis://redis:6379/0）
REDIS_URL=redis://127.0.0.1:6379/0

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 微信小程序
WECHAT_APP_ID=wx40efcaf0ff532927
WECHAT_APP_SECRET=
WECHAT_QR_PAGE=
WECHAT_ENV_VERSION=release

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=720

# Cloudflare R2（对象前缀 bookmark/）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://r2.soupcircle.xyz
R2_KEY_PREFIX=bookmark

# 字体
FONT_PATH=./assets/fonts/SourceHanSansCN-Regular.otf

# 时区
TZ=Asia/Shanghai

# NAS 出网代理（可选，Go 会自动读取）
# HTTP_PROXY=http://192.168.31.140:7890
# HTTPS_PROXY=http://192.168.31.140:7890
